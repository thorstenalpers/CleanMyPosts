{
	"name": "cleanmyposts-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "tauri dev",
		"build:extension": "node scripts/build-extension.mjs",
		"pack:extension": "node scripts/build-extension.mjs --zip",
		"dev": "vite dev",
		"dev:content": "vite build --config vite.content.config.ts",
		"build:scripts": "node scripts/build-standalone.mjs",
		"dev:extension": "node scripts/build-extension.mjs --watch",
		"dev:app": "npm run dev:content && vite dev",
		"prepare": "svelte-kit sync",
		"build": "vite build && vite build --config vite.content.config.ts && npm run build:scripts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "vite build --config vite.content.config.ts && npm run build:scripts && playwright test",
		"tauri": "tauri",
		"app:build": "tauri build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.43.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@vitest/coverage-v8": "^5.0.0",
		"bits-ui": "^2.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"zod": "^4.5.4"
	}
}
