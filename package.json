{
  "name": "cleanmyposts-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "npm run build:chrome && npm run build:content",
    "build:chrome": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build:content && playwright test"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^1.26.0",
    "@tanstack/table-core": "^8.21.3",
    "ag-grid-community": "^36.0.2",
    "bits-ui": "^2.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
