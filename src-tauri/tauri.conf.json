{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "CleanMyPosts",
	"version": "2.1.4",
	"identifier": "com.thorstenalpers.cleanmyposts",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5175",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/icon.ico"],
		"createUpdaterArtifacts": true,
		"resources": ["../THIRD_PARTY_LICENSES.txt"]
	},
	"plugins": {
		"updater": {
			"pubkey": "REPLACE_WITH_PUBLIC_KEY",
			"endpoints": [
				"https://github.com/thorstenalpers/CleanMyPosts/releases/latest/download/latest.json"
			]
		}
	}
}
