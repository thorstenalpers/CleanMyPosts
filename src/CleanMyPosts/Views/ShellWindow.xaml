<Window
    x:Class="CleanMyPosts.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:CleanMyPosts.Properties"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="{x:Static properties:Resources.AppDisplayName}"
    Width="1000"
    Height="640"
    MinWidth="480"
    MinHeight="360"
    Icon="../Assets/logo.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <wv2:WebView2 x:Name="chromeWebView" Grid.Column="0" Grid.ColumnSpan="1" />
        <wv2:WebView2 x:Name="siteWebView" Grid.Column="1" />
    </Grid>
</Window>
