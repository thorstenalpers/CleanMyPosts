<Window
    x:Class="CleanMyPosts.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="CleanMyPosts">

    <Grid x:Name="RootGrid" Loaded="OnLoaded">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                <ColumnDefinition x:Name="ContentColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <controls:WebView2 x:Name="ChromeWebView" Grid.Column="0" Grid.ColumnSpan="1" />
            <controls:WebView2 x:Name="SiteWebView" Grid.Column="1" />

            <!-- WebView2 swallows pointer input, so the drag area has to sit above it. -->
            <Border
                x:Name="DragRegion"
                Grid.Column="0"
                Height="40"
                VerticalAlignment="Top"
                Background="Transparent" />
        </Grid>

        <!-- Static placeholder shown until the Svelte UI reports itself ready. -->
        <Grid x:Name="SkeletonLayer" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="16,52,16,16" Spacing="10">
                <Rectangle Height="36" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Rectangle Height="36" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Rectangle Height="36" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Rectangle Height="36" RadiusX="10" RadiusY="10" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Rectangle Height="36" RadiusX="10" RadiusY="10" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="28,52,28,28" Spacing="14">
                <Rectangle Height="28" Width="220" HorizontalAlignment="Left" RadiusX="8" RadiusY="8"
                           Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Rectangle Height="88" RadiusX="12" RadiusY="12" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Rectangle Height="88" RadiusX="12" RadiusY="12" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Rectangle Height="88" RadiusX="12" RadiusY="12" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
